{
  "name": "md-to-openwebui",
  "version": "1.0.0",
  "private": true,
  "description": "纯前端 Markdown 对话记录转 Open WebUI JSON 工具及自动化测试套件",
  "scripts": {
    "lint:syntax": "node scripts/check-syntax.js",
    "test:unit": "node --test tests/unit/parser-converter.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/unit/parser-converter.test.js",
    "test:e2e": "playwright test",
    "test": "npm run lint:syntax && npm run test:unit",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0"
  }
}
